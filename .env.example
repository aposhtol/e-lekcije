# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/e-lekcije

# JWT Authentication
SECRET=your-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=3000
NODE_ENV=development

# YouTube API (used for fetching playlist data)
# Get your API key from: https://console.developers.google.com/
VITE_YOUTUBE_API_KEY=your-youtube-api-key-here

# Note: VITE_ prefix makes the variable available to the client-side code
# For production, consider moving YouTube API calls to backend to protect the key
